<?xml version="1.0"?>
<launch>
    <!-- Multi-robot mapping node -->
    <node name="multi_robot_mapping_node" pkg="obstacle_mapping" type="multi_robot_mapping_node"
        output="screen">
        <!-- Topic and frame settings -->
        <param name="scan_topic" value="/vehicle0/registered_scan" />
        <param name="frame_id" value="map" />
        <param name="queue_size" value="10" />

        <!-- Vehicle and debug settings -->
        <param name="debug_mode" value="false" />

        <!-- Sensor range parameters (also used as observation range for point cloud filtering) -->
        <param name="max_range" value="80.0" />
        <param name="min_range" value="0.1" />

        <!-- Point cloud Z range parameters -->
        <param name="min_z" value="-3.0" />
        <param name="max_z" value="1.3" />

        <!-- Map parameters -->
        <param name="map_resolution" value="0.5" />
        <param name="map_length_x" value="1000.0" />
        <param name="map_length_y" value="1000.0" />

        <!-- Local map visualization size -->
        <param name="local_map_size_x" value="20.0" />
        <param name="local_map_size_y" value="20.0" />

        <!-- BGK inference kernel size -->
        <param name="bgk_kernel_size" value="0.6" />

        <!-- Traversability thresholds -->
        <param name="slope_threshold" value="0.3" />
        <param name="roughness_threshold" value="0.04" />
        <param name="step_threshold" value="0.4" />
        <param name="init_trav_threshold" value="0.5" />

        <!-- Feature mapping parameters -->
        <param name="normal_estimation_radius" value="0.8" />
        <param name="step_radius" value="0.6" />
        <param name="min_normal_points" value="6" />
        <param name="thread_count" value="4" />

        <!-- Vehicle model parameters for fine-grained traversability -->
        <param name="wheeled_model_path"
            value="$(find obstacle_mapping)/test_map/vehicles/wheeled_car.csv" />
        <param name="tracked_model_path"
            value="$(find obstacle_mapping)/test_map/vehicles/tracked_car.csv" />
        <param name="robot_rows" value="9" />
        <param name="robot_cols" value="11" />
        <param name="robot_model_resolution" value="0.2" />
        <param name="touch_gap_threshold" value="0.05" />
        <param name="collision_gap_threshold" value="0.1" />
        <param name="max_iterations" value="50" />

        <!-- Fine-grained traversability computation control -->
        <!-- 姿态模型开关 -->
        <param name="enable_fine_traversability" value="true" />
        <param name="enable_incremental_geom" value="true" />
        <param name="enable_incremental_step" value="true" />
        <param name="enable_incremental_trav" value="true" />

        <!-- Fine-grained traversability range parameters -->
        <param name="fine_trav_min" value="0.4" />
        <param name="fine_trav_max" value="0.9" />
        <param name="fine_slope_min" value="0.3" />
        <param name="fine_slope_max" value="0.95" />
        <param name="fine_roughness_min" value="0.2" />
        <param name="fine_roughness_max" value="1.0" />
        <param name="fine_roll_threshold_deg" value="30.0" />
        <param name="fine_pitch_threshold_deg" value="30.0" />

        <!-- Asynchronous processing parameters -->
        <param name="skip_old_messages" value="false" />
    </node>

    <!-- RViz visualization -->
    <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find obstacle_mapping)/rviz/show_multi_robot.rviz" output="screen" />
</launch>